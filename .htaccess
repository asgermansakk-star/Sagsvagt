# Forsiden på sagsvagt.dk er tilmeldingssiden (vagt.html). Avisens forside ligger på /index.html.
# Undermapper (udvalg/, bydel/, min/) har ingen vagt.html og viser derfor deres index.html som før.
DirectoryIndex vagt.html index.html
# Egen side for adresser, der ikke findes (bygges af avis/byg.mjs)
ErrorDocument 404 /404.html
# Skjulte filer (fx uploadrobottens .ftp-*-tilstandsfiler) og PHP's fejllog kan ikke hentes udefra
<FilesMatch "^(\..+|error_log)$">
  Require all denied
</FilesMatch>

# Sikkerhed i browseren. IfModule gør, at siden stadig virker, hvis serveren mangler mod_headers.
<IfModule mod_headers.c>
  # Brug altid https (et halvt år ad gangen)
  Header always set Strict-Transport-Security "max-age=15552000"
  # Afslør ikke hele adressen (fx login-links) til andre sider
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # X-Content-Type-Options: nosniff sætter Simply selv
  # Appens service worker og manifest skal altid tjekkes, så telefonerne får den nyeste udgave
  <FilesMatch "^(sw\.js|site\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Andre sider må ikke vise Sagsvagt i en ramme (beskytter login og Min avis mod "clickjacking").
  # Undtagelse: boksene (boks.html og boks/), som andre hjemmesider netop skal kunne indlejre.
  <If "%{REQUEST_URI} !~ m#^/boks(\.html|/)#">
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
  </If>
</IfModule>
